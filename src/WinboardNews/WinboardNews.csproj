<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>   <!-- no console window, ever -->
    <AssemblyName>WinboardNews</AssemblyName>
    <RootNamespace>WinboardNews.Server</RootNamespace>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinboardNews.Core\WinboardNews.Core.csproj" />
  </ItemGroup>
</Project>
